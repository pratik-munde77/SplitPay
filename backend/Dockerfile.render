FROM eclipse-temurin:21-jdk AS build
WORKDIR /workspace
COPY gradlew ./gradlew
COPY gradle/wrapper/ ./gradle/wrapper/
COPY backend/build.gradle.kts backend/settings.gradle.kts ./backend/
COPY backend/src/ ./backend/src/
RUN sed -i 's/\r$//' gradlew && sh gradlew --no-daemon -p backend test bootJar

FROM eclipse-temurin:21-jre
WORKDIR /app
RUN groupadd --system splitpay && useradd --system --gid splitpay splitpay
COPY --from=build /workspace/backend/build/libs/splitpay-backend-0.1.0.jar /app/app.jar
ENV JAVA_TOOL_OPTIONS="-Xms64m -Xmx256m -XX:+UseSerialGC -XX:ReservedCodeCacheSize=64m -Xss512k"
USER splitpay
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
